---- factorial, compiled (reflected)
-- type: Int -> Int
-- data Bool = False | True
\ (n :: Int) ->
  letrec
    x :: Int -> Int = \ (n_1 :: Int) ->
        case n_1 == 0 of
          False -> n_1 * x (n_1 - 1)
          True -> 1
  in x n
---- factorial, compiled to C
#include <stdint.h>
#include <stdlib.h>
#include <stdio.h>
#include <math.h>

/* Data.Bool_Type.Bool: False=0, True=1 */

static int64_t x(int64_t n_1);
static int64_t x(int64_t n_1) {
  int64_t r_0;
  switch ((n_1 == 0)) {
  case 0: {
  r_0 = (n_1 * x((n_1 - 1))); break; }
  case 1: {
  r_0 = 1; break; }
  default: abort();
  }
  return r_0;
}

int64_t factorial(int64_t n) {
  return x(n);
}
---- fib, compiled (reflected)
-- type: Int -> Int
-- data Bool = False | True
\ (n :: Int) ->
  letrec
    x :: Int -> Int = \ (n_1 :: Int) ->
        case n_1 == 0 of
          False -> case (n_1 - 1) == 0 of
              False -> x (n_1 - 1) + x (n_1 - 2)
              True -> 1
          True -> 0
  in x n
---- \ x -> x * x + 1, compiled: straight line code
-- type: Int -> Int
\ (n :: Int) ->
  (n * n) + 1
---- \ x -> (\ y -> y + y) (x * x), compiled: the argument is shared
-- type: Int -> Int
\ (n :: Int) ->
  let x :: Int = n * n
  in x + x
---- factorial 10, compiled: computed by the compiler
-- type: Int
3628800
---- factorial 10 with the Y combinator, compiled: lazy at compile time
-- type: Int
3628800
---- (\ x -> 42) omega, compiled: omega is never evaluated
-- type: Int
42
---- run
([1,1,120,3628800],True)
[0,1,1,610]
(50,18)
(42,3628800,3628800)

---- eval, reflected
-- type: Term -> Res
-- data Term = Var Int | Lam Term | App Term Term | Lit Int | Prim Op Term Term | If0 Term Term Term
-- data Op = Plus | Minus | Times
-- data Env = Nil | Bind Int Env
-- data Bool = False | True
-- data Heap = Empty | Node Heap Cell Heap
-- data Cell = Thunk Env Term | Done Val
-- data Val = VInt Int | VClo Env Term
-- data Res = Res Val St
-- data St = St Int Heap Int
\ (t0 :: Term) ->
  let prim :: Op -> Int -> Int -> Int = \ (o :: Op) (x :: Int) (y :: Int) ->
        case o of
          Plus -> x + y
          Minus -> x - y
          Times -> x * y
  in letrec
       look :: Env -> Int -> Int = \ (env :: Env) (n :: Int) ->
           case env of
             Bind x3 x4 -> case n == 0 of
                 False -> look x4 (n - 1)
                 True -> x3
             _ -> fail "\"./LowLambda.hs\",64:25"
     in let half :: Int -> Int = \ (a :: Int) ->
              a `quot` 2
        in let isEven :: Int -> Bool = \ (a_1 :: Int) ->
                 (a_1 - (2 * half a_1)) == 0
           in letrec
                store :: Heap -> Int -> Cell -> Heap = \ (h :: Heap) (a_2 :: Int) (c :: Cell) ->
                    case h of
                      Empty -> Node Empty c Empty
                      Node x3_1 x4_1 x5 -> case a_2 == 1 of
                          False -> case isEven a_2 of
                              False -> Node x3_1 x4_1 (store x5 (half a_2) c)
                              True -> Node (store x3_1 (half a_2) c) x4_1 x5
                          True -> Node x3_1 c x5
              in letrec
                   fetch :: Heap -> Int -> Cell = \ (h_1 :: Heap) (a_3 :: Int) ->
                       case h_1 of
                         Node x3_2 x4_2 x5_1 -> case a_3 == 1 of
                             False -> case isEven a_3 of
                                 False -> fetch x5_1 (half a_3)
                                 True -> fetch x3_2 (half a_3)
                             True -> x4_2
                         _ -> fail "\"./LowLambda.hs\",56:24"
                 in letrec
                      ev :: St -> Env -> Term -> Res = \ (st :: St) (env_1 :: Env) (t :: Term) ->
                          case st of
                            St x3_3 x4_3 x5_2 -> let st0 :: St = St x3_3 x4_3 (x5_2 + 1)
                              in case t of
                                   Var a4 -> let a_4 :: Int = look env_1 a4
                                     in let x1_6 :: Cell = fetch x4_3 a_4
                                        in case x1_6 of
                                             Done a0 -> Res a0 st0
                                             Thunk a5 x6 -> let x1_7 :: Res = ev st0 a5 x6
                                               in case x1_7 of
                                                    Res a3 a4_1 -> case a4_1 of
                                                        St a0_1 a1 a2 -> Res a3 (St a0_1 (store a1 a_4 (Done a3)) a2)
                                   Lam a0_2 -> Res (VClo env_1 a0_2) st0
                                   App x7 x8 -> let x1_9 :: Res = ev st0 env_1 x7
                                     in case x1_9 of
                                          Res a4_2 a5_1 -> case a4_2 of
                                              VClo a2_1 a3_1 -> case a5_1 of
                                                  St a0_3 a1_1 a4_3 -> ev (St (a0_3 + 1) (store a1_1 a0_3 (Thunk env_1 x8)) a4_3) (Bind a0_3 a2_1) a3_1
                                              _ -> fail "\"./LowLambda.hs\",89:26"
                                   Lit x11 -> Res (VInt x11) st0
                                   Prim x13 x14 x15 -> let x1_12 :: Res = ev st0 env_1 x14
                                     in case x1_12 of
                                          Res a4_4 a5_2 -> case a4_4 of
                                              VInt a2_2 -> let x1_14 :: Res = ev a5_2 env_1 x15
                                                in case x1_14 of
                                                     Res a1_2 a3_2 -> case a1_2 of
                                                         VInt a0_4 -> Res (VInt (prim x13 a2_2 a0_4)) a3_2
                                                         _ -> fail "\"./LowLambda.hs\",102:34"
                                              _ -> fail "\"./LowLambda.hs\",98:26"
                                   If0 x19 x20 x21 -> let x1_16 :: Res = ev st0 env_1 x19
                                     in case x1_16 of
                                          Res a1_3 a2_3 -> case a1_3 of
                                              VInt a0_5 -> case a0_5 == 0 of
                                                  False -> ev a2_3 env_1 x21
                                                  True -> ev a2_3 env_1 x20
                                              _ -> fail "\"./LowLambda.hs\",107:26"
                    in ev (St 1 Empty 0) Nil t0

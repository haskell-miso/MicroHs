---- eval, reflected
-- type: Term -> Res
-- data Term = Var Int | Lam Term | App Term Term | Lit Int | Prim Op Term Term | If0 Term Term Term
-- data Op = Plus | Minus | Times
-- data Env = Nil | Bind Int Env
-- data Bool = False | True
-- data Heap = Empty | Node Heap Cell Heap
-- data Cell = Thunk Env Term | Done Val
-- data Val = VInt Int | VClo Env Term
-- data Res = Res Val St
-- data St = St Int Heap Int
\ (t0 :: Term) ->
  let prim :: Op -> Int -> Int -> Int = \ (o :: Op) (x :: Int) (y :: Int) ->
        case o of
          Plus -> x + y
          Minus -> x - y
          Times -> x * y
  in letrec
       look :: Env -> Int -> Int = \ (env :: Env) (n :: Int) ->
           case env of
             Bind a r -> case n == 0 of
                 False -> look r (n - 1)
                 True -> a
             _ -> fail "\"./LowLambda.hs\",64:25"
     in let half :: Int -> Int = \ (a_1 :: Int) ->
              a_1 `quot` 2
        in let isEven :: Int -> Bool = \ (a_2 :: Int) ->
                 (a_2 - (2 * half a_2)) == 0
           in letrec
                store :: Heap -> Int -> Cell -> Heap = \ (h :: Heap) (a_3 :: Int) (c :: Cell) ->
                    case h of
                      Empty -> Node Empty c Empty
                      Node l c0 r_1 -> case a_3 == 1 of
                          False -> case isEven a_3 of
                              False -> Node l c0 (store r_1 (half a_3) c)
                              True -> Node (store l (half a_3) c) c0 r_1
                          True -> Node l c r_1
              in letrec
                   fetch :: Heap -> Int -> Cell = \ (h_1 :: Heap) (a_4 :: Int) ->
                       case h_1 of
                         Node l_1 c_1 r_2 -> case a_4 == 1 of
                             False -> case isEven a_4 of
                                 False -> fetch r_2 (half a_4)
                                 True -> fetch l_1 (half a_4)
                             True -> c_1
                         _ -> fail "\"./LowLambda.hs\",56:24"
                 in letrec
                      ev :: St -> Env -> Term -> Res = \ (st :: St) (env_1 :: Env) (t :: Term) ->
                          case st of
                            St next h_2 steps -> let st0 :: St = St next h_2 (steps + 1)
                              in case t of
                                   Var n_1 -> let a_5 :: Int = look env_1 n_1
                                     in let x1_6 :: Cell = fetch h_2 a_5
                                        in case x1_6 of
                                             Done v -> Res v st0
                                             Thunk tenv tt -> let x1_7 :: Res = ev st0 tenv tt
                                               in case x1_7 of
                                                    Res v_1 st1 -> case st1 of
                                                        St next1 h1 steps1 -> Res v_1 (St next1 (store h1 a_5 (Done v_1)) steps1)
                                   Lam b -> Res (VClo env_1 b) st0
                                   App f x_1 -> let x1_9 :: Res = ev st0 env_1 f
                                     in case x1_9 of
                                          Res fv st1_1 -> case fv of
                                              VClo cenv b_1 -> case st1_1 of
                                                  St next1_1 h1_1 steps1_1 -> ev (St (next1_1 + 1) (store h1_1 next1_1 (Thunk env_1 x_1)) steps1_1) (Bind next1_1 cenv) b_1
                                              _ -> fail "\"./LowLambda.hs\",89:26"
                                   Lit n_2 -> Res (VInt n_2) st0
                                   Prim o_1 x_2 y_1 -> let x1_12 :: Res = ev st0 env_1 x_2
                                     in case x1_12 of
                                          Res vx st1_2 -> case vx of
                                              VInt i -> let x1_14 :: Res = ev st1_2 env_1 y_1
                                                in case x1_14 of
                                                     Res vy st2 -> case vy of
                                                         VInt j -> Res (VInt (prim o_1 i j)) st2
                                                         _ -> fail "\"./LowLambda.hs\",102:34"
                                              _ -> fail "\"./LowLambda.hs\",98:26"
                                   If0 c_2 x_3 y_2 -> let x1_16 :: Res = ev st0 env_1 c_2
                                     in case x1_16 of
                                          Res vc st1_3 -> case vc of
                                              VInt i_1 -> case i_1 == 0 of
                                                  False -> ev st1_3 env_1 y_2
                                                  True -> ev st1_3 env_1 x_3
                                              _ -> fail "\"./LowLambda.hs\",107:26"
                    in ev (St 1 Empty 0) Nil t0

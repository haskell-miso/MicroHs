---- squares, reflected
-- type: Mem -> Int -> Int
-- data Mem = Mem
-- data (,) #0 #1 = (,) #0 #1
-- data Bool = False | True
\ (m0 :: Mem) (n :: Int) ->
  letrec
    sumUp :: Mem -> Int -> Int -> (Int, Mem) = \ (m :: Mem) (i :: Int) (acc :: Int) ->
        case i == n of
          False -> sumUp m (i + 1) (acc + peek m[i])
          True -> (acc, m)
  in letrec
       fill :: Mem -> Int -> Mem = \ (m_1 :: Mem) (i_1 :: Int) ->
           case i_1 == n of
             False -> fill (poke m_1[i_1] (i_1 * i_1)) (i_1 + 1)
             True -> m_1
     in let x1 :: (Int, Mem) = sumUp (fill m0 0) 0 0
        in case x1 of
             (x3, x4) -> x3

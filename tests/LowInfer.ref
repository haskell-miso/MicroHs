---- sumSq, reflected
-- type: Int -> Int
-- data Bool = False | True
\ (n :: Int) ->
  letrec
    go :: Int -> Int -> Int = \ (i :: Int) (acc :: Int) ->
        case i > n of
          False -> go (i + 1) (acc + (i * i))
          True -> acc
  in go 1 0
---- sumSq, C
#include <stdint.h>
#include <stdlib.h>
#include <stdio.h>
#include <math.h>

/* Data.Bool_Type.Bool: False=0, True=1 */

static int64_t go(int64_t n, int64_t i, int64_t acc);
static int64_t go(int64_t n, int64_t i, int64_t acc) {
  int64_t r_0;
  switch ((i > n)) {
  case 0: {
  r_0 = go(n, (i + 1), (acc + (i * i))); break; }
  case 1: {
  r_0 = acc; break; }
  default: abort();
  }
  return r_0;
}

int64_t sumsq(int64_t n) {
  return go(n, 1, 0);
}
---- sumSq, JavaScript
// data Bool = False | True
function sumsq(n) {
  function go(i, acc) {
    let r_0;
    switch ((i > n ? 1 : 0)) {
    case 0: {
    r_0 = go((i + 1), (acc + (i * i))); break; }
    case 1: {
    r_0 = acc; break; }
    }
    return r_0;
  }
  return go(1, 0);
}
---- scaledArea, reflected
-- type: Double -> Shape -> Double
-- data Shape = Circle Double | Rect Double Double
\ (k :: Double) (s :: Shape) ->
  let scale :: Double -> Double = \ (x :: Double) ->
        x * k
  in case s of
       Circle r -> scale ((3.0 * r) * r)
       Rect w h -> scale (w * h)
---- scaledArea, C
#include <stdint.h>
#include <stdlib.h>
#include <stdio.h>
#include <math.h>

struct Shape { int tag; union { struct { double f0; } Circle; struct { double f0; double f1; } Rect; } u; };

static double scale(double k, double x) {
  return (x * k);
}

double scaled_area(double k, struct Shape* s) {
  double r_0;
  switch (s->tag) {
  case 0: {
  double r = s->u.Circle.f0;
  r_0 = scale(k, ((3.0 * r) * r)); break; }
  case 1: {
  double w = s->u.Rect.f0;
  double h = s->u.Rect.f1;
  r_0 = scale(k, (w * h)); break; }
  default: abort();
  }
  return r_0;
}
---- firstBig, reflected
-- type: Int -> [Int] -> Maybe Int
-- data [] #0 = [] | (:) #0 [#0]
-- data Bool = False | True
-- data Maybe #0 = Nothing | Just #0
\ (n :: Int) (xs :: [Int]) ->
  let big :: Int -> Bool = \ (x_1 :: Int) ->
        n < x_1
  in letrec
       go :: [Int] -> Maybe Int = \ (l :: [Int]) ->
           case l of
             [] -> Nothing
             x : r -> case big x of
                 False -> go r
                 True -> Just x
     in go xs
---- firstBig, JavaScript
// data [] #0 = [] | (:) #0 [#0]
// data Bool = False | True
// data Maybe #0 = Nothing | Just #0
function firstBig(n, xs) {
  function big(x_1) {
    return (n < x_1 ? 1 : 0);
  }
  function go(l) {
    let r_0;
    switch (l[0]) {
    case 0: {
    r_0 = [0]; break; }
    case 1: {
    const x = l[1];
    const r = l[2];
    let r_1;
    switch (big(x)) {
    case 0: {
    r_1 = go(r); break; }
    case 1: {
    r_1 = [1, x]; break; }
    }
    r_0 = r_1; break; }
    }
    return r_0;
  }
  return go(xs);
}
